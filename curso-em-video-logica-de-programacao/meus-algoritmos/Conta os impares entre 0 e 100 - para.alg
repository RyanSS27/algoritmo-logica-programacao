algoritmo "semnome"
// Função :
// Autor :
// Data : 07/06/2022
// Seção de Declarações 
var
   n, cont, tot: inteiro
inicio
      leia (n)
      para cont <- 1 ate n faca
           se (cont%2<>0) entao
              tot <- tot + 1
           fimse
      fimpara
      limpatela
      escreval (tot)
fimalgoritmo
