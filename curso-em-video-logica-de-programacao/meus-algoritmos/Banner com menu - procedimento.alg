algoritmo "semnome"
// Função :
// Autor :
// Data : 04/06/2022
// Seção de Declarações 
var
   cont: inteiro
   v: vetor[1..4] de inteiro
inicio
      para cont <- 1 ate 4 passo 1 faca
      escreval ("Digite o", cont, "º valor.")
           leia (v[cont])
      fimpara
      para cont <- 1 ate 4 passo 1 faca
           escreval ("V[", v[cont],"].")
      fimpara
fimalgoritmo
